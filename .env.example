# Tingy Environment Variables (example)
# Copy this file to `.env.local` and fill real values. Do NOT commit secrets.

# Vercel Blob Storage (REQUIRED for files >4MB)
# Get your token from: https://vercel.com/dashboard/stores
# Create a Blob store and copy the BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=your_blob_token_here


# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google OAuth (optional; used for sign-in)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Rate limiting (optional)
RATE_LIMIT_PER_MINUTE=10
